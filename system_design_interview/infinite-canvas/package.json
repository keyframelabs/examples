{
  "name": "@kfl-system-design/infinite-canvas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
